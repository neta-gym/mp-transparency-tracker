# Optional overrides
# MAX_CONCURRENT_MPS=3
# LOG_LEVEL=INFO
# LOG_FORMAT=rich            # "rich" (human-friendly) or "json" (structured)
# DATABASE_PATH=data/tracker.db
# DATAGOV_API_KEY=your-api-key  # Optional, for data.gov.in higher rate limits

# Optional GLM-5.3 Flash LLM assist for MPLADS sector classification.
# The pipeline runs fully keyword-based when no key is set.
# GLM_API_KEY=your-zai-key        # Preferred provider (https://z.ai)
# OPENROUTER_API_KEY=your-or-key  # Fallback provider (https://openrouter.ai)
# GLM_BASE_URL=                   # Override chat-completions base URL
# GLM_MODEL=                      # Override model slug
# GLM_TIMEOUT=30                  # Request timeout in seconds
