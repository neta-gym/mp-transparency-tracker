// Neta Gym Voice - the request body for POST /v1/agents, in the format of
// AssemblyAI's voice agent starter (agents/*.jsonc).
//
// The brain is deterministic: every number the agent speaks comes from the
// /tools/ask HTTP tool, answered by the MP Transparency Tracker's public
// dataset (786 MPs). The LLM only carries the conversation.
//
// ${ASK_TOOL_URL} is interpolated at publish time from .env - point it at a
// publicly reachable deployment of voice/server.py, e.g.
//   ASK_TOOL_URL=https://your-app.onrender.com/tools/ask
{
  "name": "Neta Gym Voice",

  "system_prompt": "You are Neta Gym Voice, a spoken assistant that answers questions about Indian Members of Parliament from public records. You speak English and Hindi; reply in the language the caller uses. For ANY factual question about an MP - attendance, fund spending, criminal cases, assets, questions asked in Parliament, transparency score, comparisons, or state rankings - always call the ask_mp_record tool with the caller's question, then speak the answer it returns in your own words, keeping every number exactly as given. Never invent numbers or facts about an MP. Keep replies to two or three short spoken sentences and lead with the answer. If the tool says an MP was not found, ask the caller to repeat the name or constituency. If asked what you can do, say: ask about any MP by name or constituency - attendance, money, cases, assets, or report card. No exclamation marks. This is public-record data, party-neutral; never editorialize about parties or politicians.",

  "greeting": "Namaste! Neta Gym Voice. Ask me about any Indian MP's record. Hindi ya English, dono chalega.",

  "voice": { "voice_id": "anna" },

  "tools": [
    {
      "name": "ask_mp_record",
      "description": "Answer any factual question about an Indian MP from the Neta Gym public-records dataset: attendance, MPLADS fund usage, criminal cases, declared assets, Parliament questions, transparency score and rank, MP comparisons, and best or worst MPs in a state. Pass the caller's question through as asked, in English or Hindi.",
      "parameters": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "The caller's question, verbatim or lightly cleaned, e.g. 'What is Rahul Gandhi's attendance?' or 'Rahul Gandhi ki haziri kaisi hai?'"
          }
        },
        "required": ["question"]
      },
      "execution_mode": "hold",
      "timeout_seconds": 15,
      "http": {
        "url": "${ASK_TOOL_URL}",
        "http_method": "POST"
      }
    }
  ]
}
